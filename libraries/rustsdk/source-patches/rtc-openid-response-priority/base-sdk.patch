+#[cfg(feature = "e2e-encryption")]
+fn next_rtc_signal_binding(room: &str, user: &str, device: &str, clear: &Value, wire: &Value) -> Result<Value> {
+    let ciphertext = wire["ciphertext"].as_str().ok_or(Error::InsufficientData)?;
+    let session = wire["session_id"].as_str().ok_or(Error::InsufficientData)?;
+    let sender_key = wire["sender_key"].as_str().ok_or(Error::InsufficientData)?;
+    let algorithm = wire["algorithm"].as_str().ok_or(Error::InsufficientData)?;
+    let member = clear["msc4354_sticky_key"].as_str().ok_or(Error::InsufficientData)?;
+    let slot = clear["slot_id"].as_str().unwrap_or("m.call#ROOM");
+    if slot != "m.call#ROOM" || ciphertext.is_empty() { return Err(Error::InsufficientData); }
+    let (action, service, predecessor) = if clear.get("member").is_some() {
+        let published = clear.get("rtc_transports").or_else(|| clear.get("transports")?.get("published"))
+            .and_then(Value::as_array).ok_or(Error::InsufficientData)?;
+        if published.len() != 1 { return Err(Error::InsufficientData); }
+        let service = published[0]["livekit_service_url"].as_str().ok_or(Error::InsufficientData)?;
+        let predecessor = clear.get("m.relation").or_else(|| clear.get("m.relates_to"))
+            .and_then(|v| v.get("event_id")).and_then(Value::as_str).unwrap_or("");
+        ("JOIN", service, predecessor)
+    } else {
+        ("LEAVE", "", "")
+    };
+    let mut parts = vec!["next.rtc.encrypted-signal.v1", room, user, device, member, slot];
+    let hash = |parts: &[&str]| -> Result<String> {
+        Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(parts)?)))
+    };
+    let scope = hash(&parts)?;
+    parts.extend([action, service, predecessor, algorithm, sender_key, session, ciphertext]);
+    Ok(serde_json::json!({"v": 1, "scope": scope, "digest": hash(&parts)?, "predecessor": predecessor}))
+}
