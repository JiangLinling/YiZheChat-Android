+    /// The observer MUST authenticate the enclosing event's internal Matrix device.
+    #[cfg(feature = "e2e-encryption")]
+    async fn send_next_rtc_sticky_encrypted(
+        &self,
+        event_type: &str,
+        content: Box<RawJsonValue>,
+        delay: Option<delayed_events::DelayParameters>,
+        duration: Duration,
+    ) -> Result<SendEventResponse> {
+        let clear: Value = serde_json::from_str(content.get())?;
+        crate::room::futures::ensure_room_encryption_ready(&self.room).await?;
+        let olm = self.room.client.olm_machine().await;
+        let olm = olm.as_ref().ok_or(Error::InsufficientData)?;
+        let encrypted = olm.encrypt_room_event_raw(
+            self.room.room_id(), event_type, &Raw::<AnyMessageLikeEventContent>::from_json(content),
+        ).await?;
