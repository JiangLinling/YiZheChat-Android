+    pub(in crate::backup) struct RefResponseBodyRepr<'a> {
+        pub algorithm: &'a RawJsonValue,
+        pub auth_data: &'a RawJsonValue,
+        pub count: UInt,
+        pub etag: &'a str,
+        pub version: &'a str,
+    }
