+
+pub mod v3 {
+    //! `/v3/` ([spec])
+    //!
+    //! [spec]: https://spec.matrix.org/v1.18/client-server-api/#post_matrixclientv3pushersset
+
+    use ruma_common::{
+        api::{auth_scheme::AccessToken, request, response},
+        metadata,
