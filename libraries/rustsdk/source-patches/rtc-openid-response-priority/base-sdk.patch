+//! `PUT /_matrix/client/*/pushrules/global/{kind}/{ruleId}/actions`
+//!
+//! This endpoint allows clients to change the actions of a push rule. This can be used to change
+//! the actions of builtin rules.
+
+pub mod v3 {
+    //! `/v3/` ([spec])
+    //!
