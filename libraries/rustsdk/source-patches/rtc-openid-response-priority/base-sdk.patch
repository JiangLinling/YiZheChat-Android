+        D: Deserializer<'de>,
+    {
+        let json = Box::<RawJsonValue>::deserialize(deserializer)?;
+
+        let state = from_raw_json_value(&json)?;
+        let LeftRoomDeHelper { timeline, account_data } = from_raw_json_value(&json)?;
+
+        Ok(Self { timeline, state, account_data })
+    }
+}
