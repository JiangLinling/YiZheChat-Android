+pub mod v3 {
+    //! `/v3/` ([spec])
+    //!
+    //! [spec]: https://spec.matrix.org/v1.18/client-server-api/#get_matrixclientv3roomsroomidstate
+
+    use ruma_common::{
+        OwnedRoomId,
+        api::{auth_scheme::AccessToken, request, response},
+        metadata,
+        serde::Raw,
