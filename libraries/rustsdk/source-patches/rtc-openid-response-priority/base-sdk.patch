+    use crate::profile::PropagateTo;
+
+    metadata! {
+        method: DELETE,
+        rate_limited: true,
+        authentication: AccessToken,
+        history: {
+            unstable("uk.tcpip.msc4133") => "/_matrix/client/unstable/uk.tcpip.msc4133/profile/{user_id}/{field}",
