+        wire.as_object_mut().ok_or(Error::InsufficientData)?.insert("org.yizhe.rtc.binding".to_owned(), binding);
+        let raw = Raw::<AnyMessageLikeEventContent>::from_json(serde_json::value::to_raw_value(&wire)?);
+        let duration_ms = duration.as_millis().min(3_600_000) as u64;
+        if let Some(delay) = delay {
+            let request = delayed_events::delayed_message_event::unstable::Request::new_raw(
+                self.room.room_id().to_owned(), TransactionId::new(), MessageLikeEventType::RoomEncrypted,
+                delay.with_sticky_duration(duration_ms), raw,
+            );
+            Ok(self.room.client.send(request).await.map(Into::into)?)
+        } else {
+            let request = ruma::api::client::message::send_message_event::v3::Request::new_raw(
+                self.room.room_id().to_owned(), TransactionId::new(), MessageLikeEventType::RoomEncrypted, raw,
+            );
+            let request = assign!(request, { sticky_duration_ms: Some(duration_ms) });
+            Ok(SendEventResponse::from_event_id(self.room.client.send(request).await?.event_id))
