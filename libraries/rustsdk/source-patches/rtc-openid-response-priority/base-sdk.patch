+            let AlgorithmWithData { algorithm, auth_data } =
+                algorithm.deserialize_as_unchecked().map_err(ser::Error::custom)?;
+
+            let repr = RefResponseBodyRepr {
+                algorithm: &algorithm,
+                auth_data: &auth_data,
+                count: *count,
