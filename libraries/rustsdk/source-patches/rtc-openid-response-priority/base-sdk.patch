+#[async_test]
+async fn test_next_encrypted_signal_http_producer_roundtrip() {
+    let (alice, bob, mock_server, handle) = run_test_driver_e2e_scoped(false, true).await;
+    let bob_room = mock_server.sync_joined_room(&bob, &ROOM_ID).await;
+    let members = EventFactory::new().room(&ROOM_ID).sender(alice.user_id().unwrap());
+    mock_server.mock_sync().ok_and_run(&alice, |sync| {
+        sync.add_joined_room(JoinedRoomBuilder::new(&ROOM_ID)
+            .add_state_event(members.member(bob.user_id().unwrap()).membership(MembershipState::Join)));
+    }).await;
+    let pending: Arc<std::sync::Mutex<PendingToDeviceMessages>> = Default::default();
+    let _key_capture = mock_server.capture_put_to_device_traffic(alice.user_id().unwrap(), pending.clone()).await;
+    negotiate_capabilities(&handle, json!([
+        "org.matrix.msc4157.send.delayed_event", "org.matrix.msc4407.send.sticky_event",
+        "org.matrix.msc2762.send.event:org.matrix.msc4143.rtc.member"
+    ])).await;
+    Mock::given(method("PUT"))
+        .and(path_regex(r"^/_matrix/client/(r0|v3)/rooms/.*/send/m\.room\.encrypted/.*$"))
+        .respond_with(|request: &Request| {
+            let delayed = request.url.query_pairs().any(|(k, _)| k == "org.matrix.msc4140.delay");
+            ResponseTemplate::new(200).set_body_json(if delayed {
+                json!({"delay_id":"synthetic-delay"})
+            } else { json!({"event_id":"$synthetic-join"}) })
+        }).expect(4).mount(&mock_server).await;
+    let base = json!({
+        "slot_id":"m.call#ROOM", "msc4354_sticky_key":"member-id",
+        "member":{"user_id":alice.user_id().unwrap(),"device_id":alice.device_id().unwrap(),"id":"member-id"},
+        "application":{"type":"m.call"},"versions":[],
+        "transports":{"can_subscribe":["livekit"],"published":[{"type":"livekit","livekit_service_url":"https://next.example/rtc/jwt"}]}
+    });
+    let mut fixtures = Vec::new();
+    for kind in ["modern", "legacy", "renewal", "delayed_leave"] {
+        let mut clear = base.clone();
+        if kind == "legacy" {
+            let transports = clear.as_object_mut().unwrap().remove("transports").unwrap();
+            clear["rtc_transports"] = transports["published"].clone();
+        }
+        if kind == "renewal" { clear["m.relation"] = json!({"rel_type":"m.reference","event_id":"$synthetic-join"}); }
+        if kind == "delayed_leave" { clear = json!({"slot_id":"m.call#ROOM","msc4354_sticky_key":"member-id"}); }
+        let mut data = json!({"type":"org.matrix.msc4143.rtc.member","content":clear,"sticky_duration_ms":60000});
+        if kind == "delayed_leave" { data["delay"] = json!(30000); }
+        send_request(&handle, kind, "send_event", data).await;
+        let response = recv_message(&handle).await;
+        assert!(response["response"].get("error").is_none(), "{response:?}");
+        let requests = mock_server.received_requests().await.unwrap();
+        let sent = requests.iter().rev().find(|r| r.url.path().contains("/send/m.room.encrypted/")).unwrap();
+        let wire: Value = serde_json::from_slice(&sent.body).unwrap();
+        assert_eq!(wire["algorithm"], "m.megolm.v1.aes-sha2");
+        assert_eq!(wire["org.yizhe.rtc.binding"]["v"], 1);
+        assert!(wire.get("member").is_none() && wire.get("slot_id").is_none());
+        let event = json!({"type":"m.room.encrypted","event_id":format!("$synthetic-{kind}"),
+            "sender":alice.user_id().unwrap(),"origin_server_ts":1700000000000u64,"content":wire});
+        let decrypted = alice.get_room(&ROOM_ID).unwrap().decrypt_event(&Raw::new(&event).unwrap().cast_unchecked(), None).await.unwrap();
+        let decoded: Value = decrypted.raw().deserialize_as().unwrap();
+        assert_eq!(decoded["type"], "org.matrix.msc4143.rtc.member");
+        assert_eq!(decoded["content"], clear);
+        fixtures.push(json!({"kind":kind,"room_id":*ROOM_ID,"user_id":alice.user_id().unwrap(),
+            "device_id":alice.device_id().unwrap(),"clear":clear,"wire":wire}));
+    }
+    // The receiving widget starts AFTER the call: its initial MSC4354 snapshot
+    // contains encrypted carriers, not the plaintext hand-written fixture above.
+    mock_server.sync_back_pending_to_device_messages(pending, &bob).await;
+    let initial: Vec<Value> = [0usize, 2, 3].iter().map(|&i| json!({
+        "type":"m.room.encrypted", "event_id":format!("$snapshot-{i}"),
+        "sender":alice.user_id().unwrap(), "origin_server_ts":1700000000000u64,
+        "content":fixtures[i]["wire"], "msc4354_sticky":{"duration_ms":60000},
+        "unsigned":{"msc4354_sticky_duration_ttl_ms":55000}
+    })).collect();
+    let decoded_peer = bob_room.decrypt_event(&Raw::new(&initial[0]).unwrap().cast_unchecked(), None).await.unwrap();
+    let peer: Value = decoded_peer.raw().deserialize_as().unwrap();
+    assert_eq!(peer["type"],"org.matrix.msc4143.rtc.member", "peer must have the actual Megolm key");
+    Mock::given(method("GET")).and(path_regex(r"^/_matrix/client/(r0|v3)/sync$"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"next_batch":"snapshot",
+            "rooms":{"join":{ROOM_ID.as_str():{"timeline":{"events":[],"limited":false},
+                "state":{"events":[]},"account_data":{"events":[]},"ephemeral":{"events":[]},
+                "msc4354_sticky":{"events":initial}}}}}))).expect(1).mount(&mock_server).await;
+    let (receiver, receiving_handle) = WidgetDriver::new(
+        WidgetSettings::new(WIDGET_ID.to_owned(),false,"https://foo.bar/widget").unwrap());
+    spawn(async move { receiver.run(bob_room,DummyCapabilitiesProvider).await.unwrap(); });
+    negotiate_capabilities(&receiving_handle,json!([
+        "org.matrix.msc4407.receive.sticky_event",
+        "org.matrix.msc2762.receive.event:org.matrix.msc4143.rtc.member"
+    ])).await;
+    // Equal timestamps use descending event ID; decrypt before ordering so
+    // the current leave reaches the widget before the superseded joins.
+    for i in [3usize,2,0] {
+        let received=recv_message(&receiving_handle).await;
+        eprintln!("Received snapshot fixture {i}: {}", received["data"]["type"]);
+        assert_eq!(received["data"]["type"],"org.matrix.msc4143.rtc.member");
+        assert_eq!(received["data"]["content"],fixtures[i]["clear"]);
+        assert_eq!(received["data"]["sender"],alice.user_id().unwrap().as_str());
+        assert_eq!(received["data"]["msc4354_sticky"]["duration_ms"],60000);
+        assert_eq!(received["data"]["unsigned"]["msc4354_sticky_duration_ttl_ms"],55000);
+    }
+    if let Ok(directory) = std::env::var("YIZHE_RTC_FIXTURE_DIR") {
+        std::fs::write(std::path::Path::new(&directory).join("rust-encrypted-signal-producer.json"),
+            serde_json::to_vec_pretty(&fixtures).unwrap()).unwrap();
+    }
+    mock_server.verify().await;
+}
