+    #[test]
+    fn serialization_of_power_levels_overridden_values_with_all_fields() {
+        let user = owned_user_id!("@carl:example.com");
+        let power_levels_event = RoomPowerLevelsContentOverride {
+            ban: Some(int!(23)),
