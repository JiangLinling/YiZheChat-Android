+#[async_test]
+async fn test_initial_sticky_snapshot_exceeds_pending_limit_without_losing_tombstone() {
+    let (_, mock_server, driver_handle) = run_test_driver(false, true).await;
+    let sticky_event = json!({
+        "content": {
+            "slot_id": "m.call#ROOM",
+            "member": {
+                "user_id": "@peer:localhost",
+                "device_id": "PEERDEVICE",
+                "id": "peer-member-id"
+            },
+            "application": { "type": "m.call" },
+            "rtc_transports": [{
+                "type": "livekit",
+                "livekit_service_url": "https://next.example/rtc/jwt"
+            }],
+            "versions": [],
+            "msc4354_sticky_key": "peer-member-id"
+        },
+        "event_id": "$peer-sticky:localhost",
+        "origin_server_ts": 1_700_000_000_000u64,
+        "sender": "@peer:localhost",
+        "type": "org.matrix.msc4143.rtc.member",
+        "msc4354_sticky": { "duration_ms": 60000 },
+        "unsigned": { "msc4354_sticky_duration_ttl_ms": 55000 }
+    });
+    let events: Vec<Value> = (0..40).map(|i| {
+        let mut event = sticky_event.clone();
+        event["event_id"] = json!(format!("$history-{i}:localhost"));
+        // The last join and tombstone deliberately tie on timestamp. The
+        // larger event ID is the current value, matching the JS sticky store.
+        event["origin_server_ts"] = json!(1_700_000_000_000u64 + if i == 38 { 39 } else { i });
+        if i == 39 {
+            event["content"] = json!({"slot_id":"m.call#ROOM", "msc4354_sticky_key":"peer-member-id"});
+        }
+        event
+    }).collect();
+    Mock::given(method("GET"))
+        .and(path_regex(r"^/_matrix/client/(r0|v3)/sync$"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "next_batch": "s-sticky-initial",
+            "rooms": {
+                "join": {
+                    ROOM_ID.as_str(): {
+                        "timeline": { "events": [], "limited": false },
+                        "state": { "events": [] },
+                        "account_data": { "events": [] },
+                        "ephemeral": { "events": [] },
+                        "msc4354_sticky": { "events": events }
+                    }
+                }
+            }
+        })))
+        .expect(1)
+        .mount(&mock_server)
+        .await;
+
+    negotiate_capabilities(
+        &driver_handle,
+        json!([
+            "org.matrix.msc4407.receive.sticky_event",
+            "org.matrix.msc2762.receive.event:org.matrix.msc4143.rtc.member"
+        ]),
+    )
+    .await;
+
+    // Hold acknowledgements until the snapshot is queued, as a real WebView does.
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    // Never expose a superseded join before its tombstone: Element Call can
+    // otherwise auto-leave during replay even though the final map is correct.
+    for i in (0..40).rev() {
+        let pushed = tokio::time::timeout(Duration::from_secs(2), recv_message(&driver_handle))
+            .await.expect("initial snapshot silently lost an event at the pending request limit");
+        assert_eq!(pushed["api"], "toWidget");
+        assert_eq!(pushed["action"], "send_event");
+        assert_eq!(pushed["data"]["event_id"], format!("$history-{i}:localhost"));
+        if i == 39 { assert!(pushed["data"]["content"].get("member").is_none()); }
+        send_response(&driver_handle, pushed["requestId"].as_str().unwrap(), "send_event", &pushed["data"], json!({})).await;
+    }
+    mock_server.verify().await;
+}
