+#[async_test]
+async fn test_completed_openid_reply_is_not_queued_behind_slow_request() {
+    let (_, mock_server, handle) = run_test_driver(false, false).await;
+    negotiate_capabilities(
+        &handle,
+        json!(["org.matrix.msc3819.send.to_device:my.custom.to_device_type"]),
+    ).await;
+
+    Mock::given(method("POST"))
+        .and(path_regex(r"^/_matrix/client/(r0|v3)/user/.*/openid/request_token$"))
+        .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_millis(100))
+            .set_body_json(json!({"access_token":"fixture-openid", "token_type":"Bearer",
+                "matrix_server_name":"example.org", "expires_in":3600})))
+        .expect(1).mount(&mock_server).await;
+    Mock::given(method("PUT"))
+        .and(path_regex(r"^/_matrix/client/(r0|v3)/sendToDevice/my\.custom\.to_device_type/.*$"))
+        .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_secs(2))
+            .set_body_json(json!({})))
+        .expect(1).mount(&mock_server).await;
+
+    send_request(&handle, "fast-openid", "get_openid", json!({})).await;
+    send_request(&handle, "slow-to-device", "send_to_device", json!({
+        "type":"my.custom.to_device_type", "encrypted":false,
+        "messages":{"@username:test.org":{"DEVICEID":{"fixture":true}}}
+    })).await;
+    let pending=recv_message(&handle).await;
+    assert_eq!(pending["action"],"get_openid");
+    assert_eq!(pending["response"]["state"],"request");
+    let credentials_result=timeout(recv_message(&handle),Duration::from_millis(750)).await;
+    if credentials_result.is_err() {
+        for request in mock_server.received_requests().await.unwrap() {
+            eprintln!("R27 fixture request {} {}",request.method,request.url.path());
+        }
+    }
+    let credentials=credentials_result.expect("completed OpenID response waited behind a later slow request");
+    assert_eq!(credentials["action"],"openid_credentials");
+    assert_eq!(credentials["data"]["original_request_id"],"fast-openid");
+    assert_eq!(credentials["data"]["state"],"allowed");
+    // The authorized mutation must still execute exactly once, in its original
+    // order. Optimizing response delivery never duplicates or cancels it.
+    let sent=recv_message(&handle).await;
+    assert_eq!(sent["action"],"send_to_device");
+    assert_eq!(sent["requestId"],"slow-to-device");
+    assert_eq!(sent["response"],json!({}));
+    mock_server.verify().await;
+}
