+#[async_test]
+async fn test_sync_service_offline_probe_preserves_unknown_token_notification() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    let mut session_changes = client.subscribe_to_session_changes();
+    server.mock_sliding_sync().error_unrecognized().mount().await;
+    server.mock_devices().respond_with(ResponseTemplate::new(401).set_body_json(json!({
+        "errcode": "M_UNKNOWN_TOKEN", "error": "Session revoked", "soft_logout": false
+    }))).mount().await;
+    let service = SyncService::builder(client).with_offline_mode().build().await.unwrap();
+    service.start().await;
+    // Use Client::send, retaining its authentication error broadcast. Android's
+    // existing delegate must still invalidate and clean up the revoked session.
+    assert_matches!(
+        tokio::time::timeout(Duration::from_secs(8), session_changes.recv()).await,
+        Ok(Ok(matrix_sdk::SessionChange::UnknownToken(_)))
+    );
+    service.stop().await;
+    assert_matches!(service.state().get(), State::Idle);
+}
