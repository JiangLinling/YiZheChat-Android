+#[async_test]
+async fn test_sync_service_offline_locked_account_waits_for_authenticated_recovery() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    // A healthy public server must not be mistaken for an unlocked account.
+    server.mock_versions().ok().mount().await;
+    let locked = ResponseTemplate::new(401)
+        .set_body_json(json!({"errcode": "M_USER_LOCKED", "error": "User account has been locked"}));
+    let sync_guard = server.mock_sliding_sync().respond_with(locked.clone()).mount_as_scoped().await;
+    let access_guard = server.mock_devices().respond_with(locked).mount_as_scoped().await;
+    let service = SyncService::builder(client).with_offline_mode().build().await.unwrap();
+    let mut states = service.state();
+    service.start().await;
+    assert_next_matches!(states, State::Running);
+    assert_next_matches_with_timeout!(states, 2000, State::Offline);
+
+    tokio::time::sleep(Duration::from_secs(6)).await;
+    assert_matches!(states.get(), State::Offline);
+    assert_pending!(states);
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests.iter().filter(|r| r.url.path() == "/_matrix/client/v3/devices").count(), 1);
+    assert!(requests.iter().filter(|r| SlidingSyncMatcher.matches(r)).count() <= 2);
+
+    drop(access_guard);
+    drop(sync_guard);
+    server.mock_devices().ok().mount().await;
+    let _sync_guard = setup_mocking_sliding_sync_server(
+        &server, Arc::new(Mutex::new(0)), Arc::new(Mutex::new(0)),
+    ).await;
+    assert_next_matches_with_timeout!(states, 12000, State::Running);
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    assert_matches!(states.get(), State::Running);
+    service.stop().await;
+    assert_next_matches_with_timeout!(states, 2000, State::Idle);
+}
