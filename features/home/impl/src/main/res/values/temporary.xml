    <string name="screen_reachability_notifications">Allow chat notifications</string>
    <string name="screen_reachability_notifications_detail">Enable notifications for YiZheChat so messages and calls can reach you.</string>
    <string name="screen_reachability_floating">Show message pop-ups</string>
    <string name="screen_reachability_floating_detail">Turn on floating or banner notifications for messages, so they appear above other apps.</string>
    <string name="screen_reachability_lock_screen">Show notifications on the lock screen</string>
    <string name="screen_reachability_lock_screen_detail">Turn on lock-screen notifications. You can hide message details to protect privacy.</string>
    <string name="screen_reachability_screen_off">Wake the screen for notifications</string>
    <string name="screen_reachability_screen_off_detail">If your phone offers a wake-screen option, turn it on so new alerts are visible while the screen is off.</string>
    <string name="screen_reachability_call">Show incoming call alerts</string>
    <string name="screen_reachability_call_detail">In YiZheChat notifications, enable Call and Ringing calls with pop-ups, sound and vibration.</string>
    <string name="screen_reachability_background_popup">Allow call screens from the background</string>
    <string name="screen_reachability_background_popup_detail">Look for Background pop-up or a similar permission. It allows the incoming-call screen to open over the current screen.</string>
    <string name="screen_reachability_overlay">Allow YiZheChat floating windows</string>
    <string name="screen_reachability_overlay_detail">This controls YiZheChat\'s own floating reminder. It is separate from the system\'s floating notifications.</string>
    <string name="screen_reachability_autostart">Allow YiZheChat to start automatically</string>
    <string name="screen_reachability_autostart_detail">Allow auto-start and, if offered, related start and background activity, so the phone does not block message or call delivery.</string>
    <string name="screen_reachability_recents_lock">Keep YiZheChat in recent tasks</string>
    <string name="screen_reachability_recents_lock_detail">On this Xiaomi phone, locking the recent-task card keeps it when you clear recent apps. This is optional and can be undone in the same menu.</string>
    <string name="screen_reachability_recents_lock_confirm">I locked the card</string>
    <string name="screen_reachability_background_activity">Allow YiZheChat to run in the background</string>
    <string name="screen_reachability_background_activity_detail">Review this phone’s background battery setting for YiZheChat so messages and calls can arrive while the app is closed.</string>
    <string name="screen_reachability_path_xiaomi_notification">On Xiaomi and REDMI: Settings &gt; Notifications &gt; App notifications &gt; YiZheChat. Menu names vary by version.</string>
    <string name="screen_reachability_path_xiaomi_floating">On Xiaomi and REDMI: Settings &gt; Notifications and status bar &gt; Floating notifications &gt; YiZheChat.</string>
    <string name="screen_reachability_path_xiaomi_lock_screen">On Xiaomi and REDMI: Settings &gt; Notifications and status bar &gt; Lock-screen notifications &gt; YiZheChat.</string>
    <string name="screen_reachability_path_vivo_notification">On vivo and iQOO: Settings &gt; Notifications and status bar &gt; App notification management &gt; YiZheChat.</string>
    <string name="screen_reachability_path_oppo_notification">On OPPO and OnePlus: Settings &gt; Notifications and status bar &gt; Notification management &gt; YiZheChat.</string>
    <string name="screen_reachability_path_honor_notification">On Honor: Settings &gt; Notifications and status bar &gt; YiZheChat. Check banners and lock-screen alerts.</string>
    <string name="screen_reachability_path_huawei_notification">On Huawei Android: search Settings for App management &gt; YiZheChat &gt; Notification management. Check banners and lock-screen alerts.</string>
    <string name="screen_reachability_path_generic_notification">Find YiZheChat under Settings &gt; Notifications &gt; App notifications.</string>
    <string name="screen_reachability_path_xiaomi_autostart">On Xiaomi and REDMI: open YiZheChat app info and turn on Auto-start.</string>
    <string name="screen_reachability_path_xiaomi_recents_lock">Open recent tasks, long-press the YiZheChat card, then tap the lock icon. This is a phone setting and cannot be enabled by the app.</string>
    <string name="screen_reachability_path_vivo_autostart">On vivo and iQOO: Settings &gt; Apps and permissions &gt; Permission management &gt; Auto-start.</string>
    <string name="screen_reachability_path_oppo_autostart">On OPPO and OnePlus: check the page that opens for Auto launch. If absent, search Settings for Auto launch; older versions may use Phone Manager.</string>
    <string name="screen_reachability_path_realme_autostart">On realme: Settings &gt; Battery &gt; App battery management &gt; YiZheChat. Allow background activity and auto launch if offered.</string>
    <string name="screen_reachability_path_samsung_background_activity">On Samsung: Battery &gt; Background usage limits &gt; Never sleeping apps. Add YiZheChat if it is missing.</string>
    <string name="screen_reachability_path_motorola_background_activity">On Motorola: open YiZheChat app info and review Battery or Manage background apps. Select Always allow if offered.</string>
    <string name="screen_reachability_path_huawei_autostart">On Honor and Huawei Android: Settings &gt; Apps &gt; App launch. Turn off automatic management, then allow auto-start, related start and background activity.</string>
    <string name="screen_reachability_path_generic_autostart">Search phone settings for Auto-start or App launch. If there is no such setting, continue.</string>
    <string name="screen_reachability_path_xiaomi_background">On Xiaomi and REDMI: YiZheChat app info &gt; Other permissions &gt; Start in background / Background pop-up.</string>
    <string name="screen_reachability_path_vivo_background">On vivo and iQOO: open YiZheChat app permissions and look for background pop-up or background activity.</string>
    <string name="screen_reachability_path_oppo_background">On OPPO and OnePlus: look for Background pop-up in YiZheChat app permissions. If absent, continue; floating-window access is checked separately.</string>
    <string name="screen_reachability_path_huawei_background">On Honor and Huawei Android: open YiZheChat permissions and look for Background pop-up. Some versions do not offer it.</string>
    <string name="screen_reachability_path_generic_background">Search YiZheChat app permissions for Background pop-up. If missing, continue.</string>
    <string name="screen_reachability_path_vivo_wake">On vivo and iQOO: Settings &gt; Notifications and status bar &gt; Lock-screen notifications &gt; Wake screen for lock-screen notifications.</string>
    <string name="screen_reachability_path_huawei_wake">On Huawei Android: search phone settings for Wake screen for notifications.</string>
    <string name="screen_reachability_path_generic_wake">Search notification settings for Wake screen. If your phone has no such switch, continue.</string>
    <string name="screen_reachability_path_overlay">If an app list opens, select YiZheChat, then allow Display over other apps.</string>
    <string name="screen_reachability_startup">Enable faster startup</string>
    <string name="screen_reachability_startup_detail">Allow background operation to help YiZheChat open faster next time.</string>
    <string name="screen_reachability_startup_open">Enable</string>
    <string name="screen_reachability_startup_path">Enable YiZhe background binding experiment and confirm the system prompts. If the accessibility list opens, find it under installed or downloaded services.</string>
    <string name="screen_reachability_startup_open_overview">Open accessibility settings</string>
    <string name="screen_reachability_startup_pending">Faster startup is not ready yet</string>
    <string name="screen_reachability_startup_pending_detail">Access is enabled, but the background service is still recovering. You can keep chatting and check again later.</string>
    <string name="screen_reachability_startup_recheck">Check again</string>
