<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="background_binding_test_label">乙者启动加速</string>
    <string name="background_binding_test_disclosure">此功能可选。通过无障碍服务连接和常驻通知，帮助乙者保持后台运行；不读取屏幕内容、不点击、不收集事件、不传输数据。系统仍可能停止服务，不能保证一直保活或每次快速启动。由你在系统无障碍设置中开启或关闭，消息和来电服务独立运行。</string>
    <string name="background_binding_test_settings">打开系统无障碍设置</string>
    <string name="background_binding_test_settings_help">在“已安装的服务”或“下载的应用”中找到“乙者启动加速”，使用系统开关开启或关闭。不同手机的名称可能不同。</string>
    <string name="background_binding_test_notification">乙者启动加速运行中</string>
    <string name="background_binding_test_notification_body">点击查看状态，或进入设置关闭。</string>
    <string name="background_binding_ready">已连接，后台常驻通知已运行</string>
    <string name="background_binding_recovering">已连接，正在恢复后台常驻通知</string>
    <string name="background_binding_waiting">已开启，等待系统连接</string>
    <string name="background_binding_disabled">尚未开启</string>
    <string name="background_binding_unknown">暂时无法确认状态，请到系统无障碍设置查看。</string>
</resources>
