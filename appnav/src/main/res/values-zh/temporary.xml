    <string name="screen_security_setup_identity_complete">数字身份已确认</string>
    <string name="screen_security_setup_location_required">完成设备信息采集</string>
    <string name="screen_security_setup_location_complete">设备信息已采集</string>
    <string name="screen_security_setup_location_explanation">为完成设备安全验证，系统需要在本次设备启用时获取一次位置信息，用于判断设备注册环境是否存在异常。该信息不会用于持续跟踪。</string>
    <string name="screen_security_setup_validation_pending">设备安全验证处理中</string>
    <string name="screen_security_setup_managed_approval_pending">本机需要受控兼容许可。安全申请已提交，正在等待管理员授权。请保持网络连接，无需重复提交。</string>
    <string name="screen_security_setup_validation_complete">设备已通过安全验证</string>
    <string name="screen_security_setup_action_required">当前设备暂未通过安全验证。请检查网络、定位权限和设备环境，或联系服务支持。</string>
    <string name="screen_security_setup_service_unavailable">安全服务暂时不可用，请稍后重试。</string>
    <string name="screen_security_setup_location_unavailable">暂时无法获取位置，请打开定位服务后重试。</string>
    <string name="screen_security_setup_location_permission_denied">完成设备安全设置需要允许位置权限。</string>
    <string name="screen_security_setup_collect_location">允许并采集位置</string>
    <string name="screen_security_setup_open_settings">打开设置并允许位置</string>
    <string name="screen_security_setup_retry">重新检查安全状态</string>
    <string name="screen_security_setup_checking">正在检查安全状态…</string>
    <string name="screen_security_setup_recovery_required">该账户已有另一台设备创建的受保护数据。你可以使用恢复密钥验证；如果恢复密钥和旧设备都无法取得，也可以明确重置加密身份。任一路径真正完成前，安全初始化不会放行。</string>
    <string name="screen_security_setup_use_recovery_key">使用恢复密钥验证</string>
    <string name="screen_security_setup_reset_identity">重置加密身份</string>
    <string name="screen_security_setup_recovery_expired">本次设备恢复请求已过期，请重新发起经过验证的恢复。</string>
    <string name="screen_security_setup_security_blocked">服务器拒绝了当前设备身份；该结果不允许进入恢复流程。请联系服务支持。</string>
    <string name="screen_device_setup_title">完成安全初始化</string>
    <string name="screen_device_setup_subtitle">逐项完成必要的系统配置，避免消息延迟、来电不响或音视频不可用。</string>
    <string name="screen_device_setup_complete_title">安全初始化已完成</string>
    <string name="screen_device_setup_complete_subtitle">设备已经完成必要配置，消息和通话功能现已可用。</string>
    <string name="screen_device_setup_complete_body">系统会在应用启动时复查可检测的关键权限；如权限被系统回收，将再次引导你恢复配置。</string>
    <string name="screen_device_setup_start_using">开始使用乙者</string>
    <string name="screen_device_setup_counter">设备配置 %1$d/%2$d</string>
    <string name="screen_device_setup_location_boundary">位置仅在设备安全准入时采集一次；这里不会开启后台持续定位。</string>
    <string name="screen_device_setup_notifications_title">消息通知</string>
    <string name="screen_device_setup_notifications_description">允许显示聊天消息和通话通知。这里申请的是应用通知权限，不会读取手机短信。</string>
    <string name="screen_device_setup_banners_title">消息横幅（悬浮通知）</string>
    <string name="screen_device_setup_banners_description">进入系统页面后，请为乙者开启“悬浮通知”“横幅”或“在屏幕上弹出”。如果不打开，消息可能只有声音并留在通知栏，不会在解锁后的屏幕顶部弹出。锁屏通知正文请继续保持隐藏。</string>
    <string name="screen_device_setup_media_title">麦克风、相机和蓝牙耳机</string>
    <string name="screen_device_setup_media_description">用于语音消息、语音通话、视频通话和蓝牙耳机。应用只会在你主动使用相关功能时访问。</string>
    <string name="screen_device_setup_calls_title">通话提醒与后台弹出</string>
    <string name="screen_device_setup_calls_description">允许来电在应用退到后台或锁屏时及时显示。小米设备需要同时允许“后台弹出界面”。</string>
    <string name="screen_device_setup_dnd_title">勿扰模式下的来电提醒</string>
    <string name="screen_device_setup_dnd_description">允许乙者来电在系统勿扰模式下响铃并显示接听、拒绝页面；不会读取其他应用的通知内容。</string>
    <string name="screen_device_setup_background_title">后台运行与省电策略</string>
    <string name="screen_device_setup_background_description">将应用电池策略设为“不限制”，避免系统休眠后停止消息同步和来电服务。</string>
    <string name="screen_device_setup_autostart_title">自启动</string>
    <string name="screen_device_setup_autostart_description">允许系统回收或手机重启后恢复后台服务，减少再次打开的等待。在系统页面为本应用开启自启动。</string>
    <string name="screen_device_setup_data_title">后台联网</string>
    <string name="screen_device_setup_data_description">允许应用在后台使用网络，避免省流量策略阻断消息同步和来电信令。</string>
